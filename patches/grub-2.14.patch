+static grub_err_t
+grub_video_gop_present_rects (const grub_video_rect_t *rects, unsigned count)
+{
+  unsigned i;
+  unsigned w = framebuffer.mode_info.width, h = framebuffer.mode_info.height;
+  if (!framebuffer.offscreen)
+    return GRUB_ERR_NONE;  /* Drawing already targeted video memory. */
+  for (i = 0; i < count; i++)
+    {
+      const grub_video_rect_t *r = &rects[i];
+      if (!r->width || !r->height)
+        continue;
+      if (r->x >= w || r->y >= h || r->width > w - r->x || r->height > h - r->y)
+        return grub_video_gop_swap_buffers ();
+      if (gop->blt (gop, framebuffer.offscreen, GRUB_EFI_BLT_BUFFER_TO_VIDEO,
+                    r->x, r->y, r->x, r->y, r->width, r->height, w * 4)
+          != GRUB_EFI_SUCCESS)
+        return grub_video_gop_swap_buffers ();
     }
   return GRUB_ERR_NONE;
 }
